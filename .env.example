# Local use: copy to .env. On Render these are Environment variables. Never commit real values.

# Who can approve access requests and invite people
ADMIN_EMAIL=kunalkaushal1120@gmail.com

# Database. Leave empty locally to use a SQLite file. In production use Postgres (Neon: postgresql://...?sslmode=require)
DATABASE_URL=

# Session signing key. Leave empty locally (one is generated). In production set a long random value.
SECRET_KEY=

# Public address of the site, e.g. https://getajob.onrender.com (used in invite links and to enable secure cookies)
PUBLIC_URL=

# Lets a scheduler call POST /api/cron/refresh with header X-Cron-Token
CRON_SECRET=

# Job APIs (optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
RAPIDAPI_KEY=
SERPAPI_KEY=

# Optional AI fit summaries
ANTHROPIC_API_KEY=

# Optional email for invites and access-request alerts (Gmail: smtp.gmail.com, 587, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
